# =============================================================
# Mavuno — Environment Variables Template
# =============================================================
# Copy to `.env` (never commit real values).
# In production set these via Vercel: `vercel env add NAME production`.
# =============================================================

# Required: HMAC secret used to sign session cookies and Trade Priority tokens.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_SECRET=change-me-please-generate-a-long-random-string

# Required for production: public URL of the deployed app.
PUBLIC_BASE_URL=https://mavuno-prototype.vercel.app

# Optional: Africa's Talking USSD sandbox credentials.
AT_USERNAME=sandbox
AT_API_KEY=

# Optional: Groq API key — enables the live AI agronomist.
# Without this the advisor falls back to a deterministic rule bank,
# so demos never go silent. Sign up at https://console.groq.com.
GROQ_API_KEY=

# Database — defaults to local SQLite if unset.
# For production, use Neon PostgreSQL:
#   1. Sign up at https://neon.tech
#   2. Create a project → copy the connection string
#   3. Install psycopg2-binary:  pip install psycopg2-binary
#   4. Set DATABASE_URL below or via Vercel env
# Example:
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/mavuno?sslmode=require
DATABASE_URL=

# Required for Social Image Uploads (Vercel Blob).
VERCEL_BLOB_READ_WRITE_TOKEN=

